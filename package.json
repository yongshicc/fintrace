{
  "name": "fintrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FinTrace — Traceable Financial Intelligence",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:references": "node scripts/verify-reference-cases.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.4.1",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
